# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=n8n

#:docker-compose.postgres.yml:docker-compose.qdrant.yml
COMPOSE_EXTENDS=

COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}

# Postgres
POSTGRES_USER=changeUser
POSTGRES_PASSWORD=changePassword
POSTGRES_DB=n8n

# n8n
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5678
VIRTUAL_HOST=n8n.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=n8n.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com