# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, oidc/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=n8n

# Docker image
IMAGE=n8nio/n8n:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# n8n
NODE_ENV=production
GENERIC_TIMEZONE=Etc/UTC

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=ac0fb0333e2ba7e45ce8faa15d05d620f13e75e83b97be3c1d1863439c95e329
N8N_USER_MANAGEMENT_JWT_SECRET=d121d8c5422de72854dc9f44c29d34f39601dd9be5f3c65b5c199694ad3785bd
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5678
VIRTUAL_HOST=n8n.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=n8n.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com

N8N_HOST=n8n.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=${N8N_PROTOCOL}://${N8N_HOST}
WEBHOOK_URL=https://${N8N_HOST}/
# OIDC
EXTERNAL_HOOK_FILES=/home/node/.n8n/hooks.js
EXTERNAL_FRONTEND_HOOKS_URLS=/assets/oidc-frontend-hook.js

N8N_TRUST_PROXY=true
N8N_PROXY_HOPS=1
N8N_ADDITIONAL_NON_UI_ROUTES=auth

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

OIDC_REDIRECT_URI=https://${N8N_HOST}/auth/oidc/callback

OIDC_USE_PKCE=true
OIDC_OWNER_EMAIL=you@example.com
OIDC_ALLOWED_GROUPS=n8n_users
OIDC_BUTTON_LABEL="Sign in with SSO"