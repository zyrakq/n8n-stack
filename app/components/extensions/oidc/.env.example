# OIDC
EXTERNAL_HOOK_FILES=/opt/n8n-oidc/hooks.js
EXTERNAL_FRONTEND_HOOKS_URLS=/assets/oidc-frontend-hook.js

N8N_TRUST_PROXY=true
N8N_PROXY_HOPS=1
N8N_ADDITIONAL_NON_UI_ROUTES=auth

OIDC_ISSUER_URL=https://kanidm.com/oauth2/openid/n8n
OIDC_CLIENT_ID=n8n
OIDC_CLIENT_SECRET=

OIDC_REDIRECT_URI=https://${N8N_HOST}/auth/oidc/callback

OIDC_USE_PKCE=true
OIDC_OWNER_EMAIL=you@example.com
OIDC_ALLOWED_GROUPS=
OIDC_BUTTON_LABEL="Sign in with SSO"