# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=n8n

# Docker image
IMAGE=n8nio/n8n:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# n8n
NODE_ENV=production
GENERIC_TIMEZONE=Etc/UTC

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=ac0fb0333e2ba7e45ce8faa15d05d620f13e75e83b97be3c1d1863439c95e329
N8N_USER_MANAGEMENT_JWT_SECRET=d121d8c5422de72854dc9f44c29d34f39601dd9be5f3c65b5c199694ad3785bd